<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cryptosuite</groupId>
    <artifactId>UltimateCryptoSuite</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>25.0.3</javafx.version>

        <!-- ProGuard: proguard-core >= 9.2.0 required for Java 25 (class version 69). -->
        <proguard.base.version>7.7.0</proguard.base.version>
        <proguard.core.version>9.3.2</proguard.core.version>

        <!-- Application metadata used by jpackage / installers. -->
        <app.mainclass>app.Launcher</app.mainclass>
        <app.name>UltimateCryptoSuite</app.name>
        <app.vendor>emilyedward</app.vendor>
        <app.version>1.0.0</app.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-media</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>

        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>4.11.1</version>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13.3</version>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.77</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.9</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.9</version>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.png</include>
                    <include>**/*.css</include>
                    <include>**/*.fxml</include>
                    <include>**/*.properties</include>
                    <include>**/*.json</include>
                    <include>**/*.mp3</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>app.Launcher</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics</option>
                        <option>--add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED</option>
                    </options>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>app.Launcher</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/maven/**/pom.xml</exclude>
                                        <exclude>META-INF/maven/**/pom.properties</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Activation: -Pobfuscate
            Runs ProGuard over the shaded jar producing
            target/UltimateCryptoSuite-1.0-SNAPSHOT-obfuscated.jar
        -->
        <profile>
            <id>obfuscate</id>
            <build>
                <plugins>
                    <!--
                        ProGuard obfuscation.
                        Requires proguard-core >= 9.2.0 to parse Java 25 bytecode.
                    -->
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <version>2.6.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.guardsquare</groupId>
                                <artifactId>proguard-base</artifactId>
                                <version>${proguard.base.version}</version>
                            </dependency>
                            <!-- Overrides transitive proguard-core 9.1.10 (max Java 24)
                                 with a build that understands class version 69 (Java 25). -->
                            <dependency>
                                <groupId>com.guardsquare</groupId>
                                <artifactId>proguard-core</artifactId>
                                <version>${proguard.core.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>obfuscate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>proguard</goal>
                                </goals>
                                <configuration>
                                    <proguardVersion>${proguard.base.version}</proguardVersion>
                                    <injar>${project.build.finalName}.jar</injar>
                                    <outjar>${project.build.finalName}-obfuscated.jar</outjar>
                                    <obfuscate>true</obfuscate>
                                    <injarNotExistsSkip>true</injarNotExistsSkip>
                                    <includeDependency>false</includeDependency>
                                    <attach>true</attach>
                                    <attachArtifactClassifier>obfuscated</attachArtifactClassifier>
                                    <options>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.base.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.desktop.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.xml.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.management.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.logging.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.net.http.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.naming.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/jdk.crypto.ec.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.security.jgss.jmod(!**.jar;!module-info.class)</option>
                                        <option>-keepattributes *Annotation*,Signature,Exceptions,InnerClasses,EnclosingMethod</option>
                                        <option>-dontwarn</option>
                                        <option>@${project.basedir}/proguard-rules.pro</option>
                                    </options>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Activation: -Pnative
            Produces a thin (no JavaFX) obfuscated jar for jpackage:
            target/UltimateCryptoSuite-1.0-SNAPSHOT-obfuscated.jar
            JavaFX is provided by the jlink runtime image instead.
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>app.Launcher</mainClass>
                                        </transformer>
                                    </transformers>
                                    <filters>
                                        <filter>
                                            <artifact>org.openjfx:*</artifact>
                                            <excludes>
                                                <exclude>**</exclude>
                                            </excludes>
                                        </filter>
                                        <filter>
                                            <artifact>*:*</artifact>
                                            <excludes>
                                                <exclude>META-INF/*.SF</exclude>
                                                <exclude>META-INF/*.DSA</exclude>
                                                <exclude>META-INF/*.RSA</exclude>
                                                <exclude>META-INF/maven/**/pom.xml</exclude>
                                                <exclude>META-INF/maven/**/pom.properties</exclude>
                                            </excludes>
                                        </filter>
                                    </filters>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Thin jar has no JavaFX classes, so ProGuard needs the JavaFX
                         jmods on its library path to resolve inherited members
                         (e.g. Application.launch referenced by app.MainApp).
                         NOTE: profile config REPLACES the base <options> list, so
                         the full list (JDK jmods + JavaFX jmods) is repeated here. -->
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>obfuscate</id>
                                <configuration>
                                    <options>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.base.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.desktop.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.xml.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.management.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.logging.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.net.http.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.naming.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/jdk.crypto.ec.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${env.JAVA_HOME}/jmods/java.security.jgss.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${project.build.directory}/jmods/javafx-jmods-${javafx.version}/javafx.base.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${project.build.directory}/jmods/javafx-jmods-${javafx.version}/javafx.controls.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${project.build.directory}/jmods/javafx-jmods-${javafx.version}/javafx.fxml.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${project.build.directory}/jmods/javafx-jmods-${javafx.version}/javafx.graphics.jmod(!**.jar;!module-info.class)</option>
                                        <option>-libraryjars ${project.build.directory}/jmods/javafx-jmods-${javafx.version}/javafx.media.jmod(!**.jar;!module-info.class)</option>
                                        <option>-keepattributes *Annotation*,Signature,Exceptions,InnerClasses,EnclosingMethod</option>
                                        <option>-dontwarn</option>
                                        <option>@${project.basedir}/proguard-rules.pro</option>
                                    </options>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>